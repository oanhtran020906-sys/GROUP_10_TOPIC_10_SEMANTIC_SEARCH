# --- DATABASE CONFIGURATION ---
# Định dạng: postgresql://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL=postgresql://postgres:password@localhost:5432/semantic_search

# --- QDRANT CONFIGURATION ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=laptop_products

# --- AI & EMBEDDING CONFIGURATION ---
# Nếu dùng OpenAI thì điền Key vào đây
OPENAI_API_KEY=sk-xxxx_your_openai_key_here

# Nếu dùng Model Local (Sentence Transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- SERVER CONFIGURATION ---
PORT=8000
DEBUG=True